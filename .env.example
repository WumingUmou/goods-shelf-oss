# goods-shelf configuration. One KEY=VALUE per line; comments go on their own line.
# Copy to .env and adjust. Changes take effect with: docker compose up -d

# ── basics ────────────────────────────────────────────────────────────────
# Host port the app listens on
GS_PORT=8090
# Data directory: database + all images. Back this directory up.
GS_DATA=./data
TZ=Asia/Shanghai
# Container name — use a different one (and port / data dir) for each instance on the same host
GS_NAME=goods-shelf
# User the app runs as; it must be able to write GS_DATA
# GS_UID=1000
# GS_GID=1000

# Operation log for /logs (records client IP, user agent, action). off = record nothing new.
ACTIVITY_LOG=on

# Optional features, comma-separated: search, tailscale   (e.g. COMPOSE_PROFILES=search,tailscale)
COMPOSE_PROFILES=

# ── auto image search (profile: search) ──────────────────────────────────
# SEARXNG_URL=http://searxng:8080
# Random string, e.g. from: openssl rand -hex 32
# SEARXNG_SECRET=

# ── HTTPS on your tailnet (profile: tailscale) ───────────────────────────
# Device name → https://goods-shelf.<your-tailnet>.ts.net
# TS_HOSTNAME=goods-shelf
# One-time key from https://login.tailscale.com/admin/settings/keys
# TS_AUTHKEY=

# ── scripts/backup.sh (restic) ───────────────────────────────────────────
# BACKUP_REPOSITORY=sftp:user@backup-host:backups/goods-shelf
# Long random string — keep a copy elsewhere, backups cannot be decrypted without it
# (wrap it in single quotes if it contains $, e.g. RESTIC_PASSWORD='a$b')
# RESTIC_PASSWORD=
# BACKUP_SSH_KEY=~/.ssh/goods_backup_ed25519
# Optional Uptime Kuma push monitor URL
# BACKUP_PUSH_URL=
